{
	"$schema": "https://docs.renovatebot.com/renovate-schema.json",
	"baseBranchPatterns": ["main"],
	"extends": [
		"config:recommended",
		":widenPeerDependencies",
		"group:githubArtifactActions"
	],
	"labels": [],
	"lockFileMaintenance": {
		"enabled": true,
		"extends": ["schedule:monthly"]
	},
	"packageRules": [
		{
			"matchDatasources": ["npm"],
			"minimumReleaseAge": "1 month"
		},
		{
			"groupName": "changesets ecosystem",
			"matchPackageNames": ["@changesets/*"]
		},
		{
			"description": "Hold changesets/action at v1: opx release bundles Changesets CLI 2, and action v2 needs CLI 3. Move both together when opx bundles CLI 3.",
			"matchManagers": ["github-actions"],
			"matchPackageNames": ["changesets/action"],
			"allowedVersions": "/^v?1(\\.\\d+){0,2}$/"
		}
	],
	"rebaseWhen": "behind-base-branch",
	"reviewers": ["castastrophe"]
}
